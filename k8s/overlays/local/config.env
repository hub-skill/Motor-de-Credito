PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=motor_credito
PG_USER=motor_app
PG_SSLMODE=prefer
PG_POOL_MIN=1
PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=10000
ORACLE_DSN=host.docker.internal:1521/XEPDB1
ORACLE_SCHEMA=MOTOR_CREDITO
ORACLE_USER=MOTOR_APP
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_CALL_TIMEOUT_MS=10000
MOTOR_BANCO=postgres
APP_ENV=dev
ENABLE_DOCS=true
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT=60/minute
ALLOWED_HOSTS=["localhost","motor-credito-py","motor-credito-py.motor-credito-py.svc","motor-credito-py.motor-credito-py.svc.cluster.local"]
