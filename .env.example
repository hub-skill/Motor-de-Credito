# Copie para .env e preencha. Nunca versione o .env.

# --- PostgreSQL (banco do motor de crédito) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=motor_credito
PG_USER=motor_app
# A mesma senha definida no \password do script banco/01_criar_banco_usuario.sql
PG_PASSWORD=
PG_SSLMODE=prefer
PG_POOL_MIN=1
PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=10000

# --- PostgreSQL: administrador (só para criar/alterar tabelas; a aplicação usa PG_USER) ---
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=

# --- Oracle (XE 21c local, banco plugável XEPDB1) ---
ORACLE_DSN=localhost:1521/XEPDB1
# Dono das tabelas (schema-only, sem login). Criado pelo script.
ORACLE_SCHEMA=MOTOR_CREDITO
# Usuário da aplicação. Criado pelo script com a senha abaixo.
ORACLE_USER=MOTOR_APP
ORACLE_PASSWORD=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_CALL_TIMEOUT_MS=10000
# Administrador (só para criar usuários e tabelas)
ORACLE_ADMIN_USER=SYSTEM
ORACLE_ADMIN_PASSWORD=

# --- API do motor (FastAPI) ---
# Chave que os clientes enviam no header X-API-Key. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Banco consultado pela API: postgres ou oracle (as tabelas existem nos dois)
MOTOR_BANCO=postgres
APP_ENV=dev
ENABLE_DOCS=true
ALLOWED_HOSTS=["localhost","127.0.0.1"]
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT=60/minute
